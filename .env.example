# Unified Paper-Trading System Configuration
# Copy this to .env and keep all credentials out of version control.

# Database (Archives-native SQLite default)
DATABASE_URL=sqlite:////Volumes/Archives/Hermes-Offload/2026-08-23/trading-system/data/ledgers/tradingbot.db
# PostgreSQL shape only (replace placeholders locally; never commit credentials):
# DATABASE_URL=postgresql://user:password@localhost/tradingbot

# Paper-only execution safety. Any mode other than "paper", or enabling live
# trading, is rejected during FastAPI startup before database/scheduler startup.
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
ACTIVE_PRODUCT_SCOPE=unified_paper
SIMULATION_MODE=true
GLOBAL_TRADING_KILL_SWITCH=false

# Archives-native runtime roots
TRADING_SYSTEM_ROOT=/Volumes/Archives/Hermes-Offload/2026-08-23/trading-system/unified-trading-system
TRADING_DATA_ROOT=/Volumes/Archives/Hermes-Offload/2026-08-23/trading-system/data
TRADING_ARTIFACTS_ROOT=/Volumes/Archives/Hermes-Offload/2026-08-23/trading-system/artifacts
TRADING_LOG_ROOT=/Volumes/Archives/Hermes-Offload/2026-08-23/trading-system/logs
TRADING_SYMBOL_ALLOWLIST=SPY,QQQ,BTC/USD,ETH/USD

# Unified risk limits
MAX_ORDER_NOTIONAL_USD=250.0
MAX_ORDER_EQUITY_FRACTION=0.01
MAX_SYMBOL_EXPOSURE_FRACTION=0.05
MAX_GROSS_EXPOSURE_FRACTION=0.25
MAX_CRYPTO_EXPOSURE_FRACTION=0.10
MAX_DAILY_LOSS_FRACTION=0.01
MAX_MARKET_DATA_AGE_SECONDS=30

# Simulation sizing
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.08

# App lifecycle / lanes
# SCHEDULER_AUTOSTART=false makes FastAPI startup (and the TestClient) construct
# the app WITHOUT launching any background scan/settlement/paper jobs. Set this
# for read-only API smokes so importing the app never trades.
SCHEDULER_AUTOSTART=true
# Both stock/crypto execution and the legacy BTC prediction-market lane remain
# disabled by default. Do not rely on MIN_EDGE_THRESHOLD=999 as an off-switch.
STOCK_CRYPTO_LANE_ENABLED=false
BTC_LANE_ENABLED=false

# Alpaca paper API only. Use paper-account keys locally; blanks are intentional.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Robinhood and Coinbase execution integrations are deferred and disabled.
# Do not add their credentials to this file.

# Polymarket APIs (Gamma/Data/public CLOB are unauthenticated)
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com

# Polymarket CLOB L2 auth (optional; never commit real values)
POLYMARKET_API_KEY_ID=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_ADDRESS=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_ENABLE_AUTHENTICATED_CLOB=false

# Polymarket relayer API (separate from Gamma/Data/CLOB)
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Kalshi API (RSA key auth for weather markets)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=true

# Weather paper execution controls (public discovery/calibration can stay enabled)
WEATHER_KALSHI_PAPER_EXECUTION_ENABLED=false
FRED_API_KEY=
BLS_API_KEY=

# Mapbox token for map visualization (optional; blank by default)
VITE_MAPBOX_TOKEN=
